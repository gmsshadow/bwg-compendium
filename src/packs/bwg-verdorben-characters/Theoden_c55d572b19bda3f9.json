  {
   "name": "Doctrine",
   "type": "skill",
   "img": "icons/sundries/books/book-worn-blue.webp",
   "system": {
    "name": "",
    "shade": "B",
    "exp": 4,
    "routine": 0,
    "difficult": 0,
    "challenging": 0,
    "root1": "perception",
    "root2": "",
    "learning": false,
    "learningProgress": 0,
    "skilltype": "schoolofthought",
    "training": false,
    "magical": false,
    "description": "Doctrine describes the tenets and beliefs of a particular religious faith.\n\nA character may only take the following variations if they were available on his lifepaths or through general skill points:\n\nCult Doctrine is the application of a belief system to a non-standard, unapproved or independent school of thought.\n\nForeign Doctrine is the knowledge or study of an accepted popular religion from another land or culture.\n\nHeretical Doctrine is the understanding and knowledge of a set of beliefs and tenets that are an offshoot of the popular religion but are not commonly accepted by the religious power structure.\n\nObstacles: Common, popular beliefs, Ob 1. Citing relevant passages from common religious texts, Ob 2. Naming an obscure saint, Ob 3.\n\nFoRKs: Philosophy\n\nSkill Type: School of Thought. Tools: No.\n\nRoot: Perception\n\nSource: Burning Wheel Gold Revised, p. 268",
    "collapsed": false,
    "persona": 0,
    "fate": 0,
